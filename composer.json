{
    "name": "ernestdefoe/kindred",
    "description": "Similar discussions at the foot of every discussion, the way traditional forums keep readers on the site.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "similar",
        "related",
        "discussions"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/kindred",
    "support": {
        "forum": "https://discuss.flarum.org/d/39991-kindred",
        "issues": "https://github.com/ernestdefoe/kindred/issues",
        "source": "https://github.com/ernestdefoe/kindred"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Discussions in the same tags rank higher, and each result shows its tags."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Kindred\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Kindred\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Kindred",
            "category": "feature",
            "icon": {
                "name": "fas fa-layer-group",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
