{
    "name": "ernestdefoe/kindred",
    "description": "Similar discussions at the foot of every discussion, the way traditional forums keep readers on the site.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "similar",
        "related",
        "discussions"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/kindred",
    "support": {
        "issues": "https://github.com/ernestdefoe/kindred/issues",
        "source": "https://github.com/ernestdefoe/kindred"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Discussions in the same tags rank higher, and each result shows its tags."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Kindred\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Kindred",
            "category": "feature",
            "icon": {
                "name": "fas fa-layer-group",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
